# Documentation only: .env files are not loaded automatically.
# Add actual values in the hosting service's environment settings.
# Never commit PINs, API keys, OAuth secrets, tokens, or database backups.

# Required for a public deployment. All team members share this PIN.
# APP_PIN=

# Public HTTPS origin, without a path or trailing slash.
# On Render the server can use the injected RENDER_EXTERNAL_URL instead.
# APP_ORIGIN=https://your-studio.onrender.com
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=10000
# DATABASE_PATH=/var/data/studio.sqlite

# Optional OpenAI API integration; separate from ChatGPT Plus billing/memory.
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini

# Optional Google Calendar integration. Configure both, then connect in the app.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Authorized redirect URI in Google Cloud:
# https://your-studio.onrender.com/api/integrations/google/callback
# Google tokens are encrypted with a key persisted alongside the database.
# Do not replace or delete that key while keeping the encrypted credentials.
